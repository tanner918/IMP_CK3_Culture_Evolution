        <node id="n9::n48">
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="44.96991532845357" width="392.8365625264298" x="5524.313240838912" y="-1081.1872438295613"/>
              <y:Fill color="#FFCC00" transparent="false"/>
